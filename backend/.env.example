# ============================================================
# Claude API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 数据库连接
# DB_HOST 填 host.docker.internal
# AI 助手容器通过宿主机访问你现有的 MySQL 容器
# 前提：现有 MySQL 容器已将 3306 端口映射到宿主机（ports: "3306:3306"）
# ============================================================
CRM_DB_HOST=host.docker.internal
CRM_DB_PORT=3306
CRM_DB_NAME=crm_os
CRM_DB_USER=root
CRM_DB_PASSWORD=your_password

ERP_DB_HOST=host.docker.internal
ERP_DB_PORT=3306
ERP_DB_NAME=erp_os
ERP_DB_USER=root
ERP_DB_PASSWORD=your_password

# ERP 组织 ID（写死为 1）
ERP_ORG_ID=1

# ============================================================
# JWT（用户登录 Session 管理）
# JWT_SECRET 用 openssl rand -hex 32 生成一个随机字符串
# ============================================================
JWT_SECRET=replace-with-random-secret-openssl-rand-hex-32
JWT_EXPIRE_HOURS=24

# ============================================================
# Google reCAPTCHA v2（登录失败 3 次后验证）
# 申请地址：https://www.google.com/recaptcha/admin
# 选择 reCAPTCHA v2 → "我不是机器人"复选框
# ============================================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
