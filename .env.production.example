# ============================================================
# 生产环境变量（复制为 .env，与 docker-compose.yml 同目录）
#   cp .env.production.example .env && vim .env
# ============================================================

# ------------------------------------------------------------
# Claude API
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# 数据库连接
# 容器已加入共享 data_net，通过容器名直连 infra_mysql（无需 host.docker.internal）
# 账号为只读账号 ai_readonly（见 setup_readonly_user.sql，需提前在 infra_mysql 执行）
# ------------------------------------------------------------
CRM_DB_HOST=infra_mysql
CRM_DB_PORT=3306
CRM_DB_NAME=crm_os
CRM_DB_USER=ai_readonly
CRM_DB_PASSWORD=change_me

ERP_DB_HOST=infra_mysql
ERP_DB_PORT=3306
ERP_DB_NAME=erp_os
ERP_DB_USER=ai_readonly
ERP_DB_PASSWORD=change_me

# ERP 组织 ID（写死为 1）
ERP_ORG_ID=1

# ------------------------------------------------------------
# 镜像拉取（GitHub Actions 自动写入，手动部署需自行设置）
# ------------------------------------------------------------
GHCR_OWNER=kelvinpang90
IMAGE_TAG=latest

# ============================================================
# JWT（用户登录 Session 管理）
# JWT_SECRET 用 openssl rand -hex 32 生成一个随机字符串
# ============================================================
JWT_SECRET=replace-with-random-secret-openssl-rand-hex-32
JWT_EXPIRE_HOURS=24

# ============================================================
# Google reCAPTCHA v2（登录失败 3 次后验证）
# 申请地址：https://www.google.com/recaptcha/admin
# 选择 reCAPTCHA v2 → "我不是机器人"复选框
# ============================================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key